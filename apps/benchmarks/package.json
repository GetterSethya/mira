{
  "name": "mira-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx src/runner.ts",
    "bulk-create:audit": "node src/bulk-create-audit.ts",
    "perf:audit": "node src/audit.ts",
    "create-batch:audit": "node src/create-batch-audit.ts",
    "profile:mutation": "tsx src/profile-mutation.ts",
    "analyze:cpu": "tsx src/analyze-cpuprofile.ts",
    "perf:analyze": "node src/analyze-profiles.ts",
    "query-plan": "tsx src/query-plan.ts",
    "test": "node --import tsx --test tests/analyze-heapprofile.test.ts",
    "server:node": "node src/server.ts",
    "server:bun": "bun run src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/sql-sqlite-bun": "4.0.0",
    "@effect/sql-sqlite-node": "4.0.0",
    "@gettersethya/mira": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
