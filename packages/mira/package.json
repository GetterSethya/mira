{
  "name": "@gettersethya/mira",
  "version": "0.1.0-alpha.34",
  "type": "module",
  "description": "Self-hosted backend in TypeScript using Effect",
  "author": "Getter Sethya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetterSethya/mira.git",
    "directory": "packages/mira"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/check-exports.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.5",
    "@effect/platform-node": "^4.0.0",
    "@effect/sql-sqlite-node": "^4.0.0",
    "@gettersethya/mira-client": "workspace:*",
    "chalk": "^6.0.1",
    "jose": "^6.2.3",
    "mime": "^4.0.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0",
    "@types/node": "^25.7.0",
    "effect": "^4.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
