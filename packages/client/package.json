{
  "name": "@gettersethya/mira-client",
  "version": "0.1.0-alpha.32",
  "type": "module",
  "description": "Collection definitions and client SDK for Mira",
  "author": "Getter Sethya",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/check-exports.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@gettersethya/mira-collection": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0",
    "@types/node": "^25.7.0",
    "effect": "^4.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
