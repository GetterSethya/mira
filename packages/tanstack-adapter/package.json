{
  "name": "@gettersethya/mira-tanstack-adapter",
  "version": "0.1.0-alpha.23",
  "type": "module",
  "description": "Framework-agnostic TanStack Query adapter for the @gettersethya/mira client SDK",
  "author": "Getter Sethya",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && node scripts/check-exports.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pack": "node scripts/check-exports.ts"
  },
  "peerDependencies": {
    "@gettersethya/mira-client": "*"
  },
  "devDependencies": {
    "@gettersethya/mira-client": "workspace:*",
    "effect": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
