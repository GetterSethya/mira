{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "outDir":           "dist",
    "baseUrl":          ".",
    "ignoreDeprecations": "6.0",
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "strict":           true,
    "skipLibCheck":     true
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
